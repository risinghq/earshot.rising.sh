{
  "name": "music-stats-web",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    // Numeric GitHub ids, comma separated. Filled in per deployment.
    "ADMIN_GITHUB_IDS": "20960328",
    // The "earshot" client of the shared rising.sh Google project. The id is
    // public; its secret is the GOOGLE_CLIENT_SECRET Worker secret.
    "GOOGLE_CLIENT_ID": "366344968940-38bb4u65ndtg1gp25l8etofahvetim88.apps.googleusercontent.com",
  },
  "routes": [
    { "pattern": "earshot.rising.sh", "custom_domain": true },
    { "pattern": "music.rising.sh", "custom_domain": true },
  ],
  "triggers": { "crons": ["* * * * *"] },
  // vite build writes the browser assets here; wrangler runs it before dev
  // and deploy.
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-stats",
      "database_id": "1c5179e3-3b60-4dfe-89d2-271170894ef0",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0d3598a079d34bab8e6422847cb34fd9",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "SOLO", "class_name": "SoloGame" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v3", "new_sqlite_classes": ["SoloGame"] },
  ],
}
